<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_rl_velocity</name>
  <version>0.1.0</version>
  <description>
    RL velocity-tracking locomotion controller for the Unitree Go2. Runs a blind
    proprioceptive policy (trained in mjlab, exported to ONNX) at 50 Hz and drives the
    robot through the unitree_ros2 low-level bridge.
  </description>
  <maintainer email="antonioavila433@gmail.com">antonio</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ament_index_cpp</depend>

  <!-- Provided by the unitree_ros2 workspace, which must be sourced as an underlay.
       There is no rosdep key for it; see README.md. Without it the controller node is
       skipped and only the policy core library and its tests are built. -->
  <depend>unitree_go</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
